{
  "name": "@connector-hub/testkit",
  "version": "0.1.0",
  "description": "In-memory host ports and HTTP fixture replay for testing connector-hub plugins.",
  "keywords": [
    "connector-hub",
    "testing",
    "fixtures",
    "connector"
  ],
  "license": "Apache-2.0",
  "author": "Akash Kumar Singh",
  "homepage": "https://github.com/akashks1998/connector-hub/tree/main/packages/testkit#readme",
  "bugs": "https://github.com/akashks1998/connector-hub/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akashks1998/connector-hub.git",
    "directory": "packages/testkit"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@connector-hub/core": "workspace:^",
    "@connector-hub/spec": "workspace:^"
  }
}
