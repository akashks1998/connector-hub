{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "domain": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "description": {
      "type": "string"
    },
    "entities": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "key": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "fields": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "string",
                    "int",
                    "double",
                    "bool",
                    "date",
                    "timestamp",
                    "json"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "string",
                        "int",
                        "double",
                        "bool",
                        "date",
                        "timestamp",
                        "json"
                      ]
                    },
                    "description": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "type"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "enum": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "description": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "enum"
                  ]
                }
              ]
            }
          }
        },
        "required": [
          "key",
          "fields"
        ]
      }
    },
    "operations": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "entity": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "upsert",
              "patch",
              "delete"
            ]
          }
        },
        "required": [
          "entity",
          "kind"
        ]
      }
    }
  },
  "required": [
    "domain",
    "version",
    "entities",
    "operations"
  ],
  "$id": "https://unpkg.com/connector-hub/schema/domain.schema.json",
  "title": "connector-hub domain pack"
}
