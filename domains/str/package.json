{
  "name": "@connector-hub/domain-str",
  "version": "0.1.0",
  "description": "Short-term rental domain pack for connector-hub: listings, calendar days and bookings.",
  "keywords": [
    "connector-hub",
    "short-term-rental",
    "vacation-rental",
    "domain-pack"
  ],
  "license": "Apache-2.0",
  "author": "Akash Kumar Singh",
  "homepage": "https://github.com/akashks1998/connector-hub/tree/main/domains/str#readme",
  "bugs": "https://github.com/akashks1998/connector-hub/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akashks1998/connector-hub.git",
    "directory": "domains/str"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
